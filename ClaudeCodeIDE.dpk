package ClaudeCodeIDE;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE RELEASE}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Claude Code IDE Integration'}
{$LIBSUFFIX AUTO}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vcl,
  designide,
  IndySystem,
  IndyCore;

contains
  ClaudeCode.Utils in 'src\ClaudeCode.Utils.pas',
  ClaudeCode.WebSocket in 'src\ClaudeCode.WebSocket.pas',
  ClaudeCode.Diff in 'src\ClaudeCode.Diff.pas',
  ClaudeCode.Mcp in 'src\ClaudeCode.Mcp.pas',
  ClaudeCode.Build in 'src\ClaudeCode.Build.pas',
  ClaudeCode.TextSync in 'src\ClaudeCode.TextSync.pas',
  ClaudeCode.DiffForm in 'src\ClaudeCode.DiffForm.pas',
  ClaudeCode.EditorSync in 'src\ClaudeCode.EditorSync.pas',
  ClaudeCode.ComponentProps in 'src\ClaudeCode.ComponentProps.pas',
  ClaudeCode.FormTools in 'src\ClaudeCode.FormTools.pas',
  ClaudeCode.DebugTools in 'src\ClaudeCode.DebugTools.pas',
  ClaudeCode.FileHistory in 'src\ClaudeCode.FileHistory.pas',
  ClaudeCode.SettingsForm in 'src\ClaudeCode.SettingsForm.pas',
  ClaudeCode.ClaudeMd in 'src\ClaudeCode.ClaudeMd.pas',
  ClaudeCode.ContextMenus in 'src\ClaudeCode.ContextMenus.pas',
  ClaudeCode.IdeBackend in 'src\ClaudeCode.IdeBackend.pas',
  ClaudeCode.Launcher in 'src\ClaudeCode.Launcher.pas',
  ClaudeCode.ConPty in 'src\ClaudeCode.ConPty.pas',
  ClaudeCode.WebViewHost in 'src\ClaudeCode.WebViewHost.pas',
  ClaudeCode.TerminalFrame in 'src\ClaudeCode.TerminalFrame.pas' {ClaudeTerminalFrame: TFrame},
  ClaudeCode.TerminalPanel in 'src\ClaudeCode.TerminalPanel.pas',
  ClaudeCode.Wizard in 'src\ClaudeCode.Wizard.pas';

end.
