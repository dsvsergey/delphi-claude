package ClaudeCodeIDE;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE RELEASE}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'Claude Code IDE Integration'}
{$LIBSUFFIX AUTO}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vcl,
  designide,
  dbrtl,
  IndySystem,
  IndyCore;

contains
  ClaudeCode.Utils in 'src\ClaudeCode.Utils.pas',
  ClaudeCode.Process in 'src\ClaudeCode.Process.pas',
  ClaudeCode.PascalIndex in 'src\ClaudeCode.PascalIndex.pas',
  ClaudeCode.WebSocket in 'src\ClaudeCode.WebSocket.pas',
  ClaudeCode.Diff in 'src\ClaudeCode.Diff.pas',
  ClaudeCode.Mcp in 'src\ClaudeCode.Mcp.pas',
  ClaudeCode.Build in 'src\ClaudeCode.Build.pas',
  ClaudeCode.TestRunner in 'src\ClaudeCode.TestRunner.pas',
  ClaudeCode.TextSync in 'src\ClaudeCode.TextSync.pas',
  ClaudeCode.DiffForm in 'src\ClaudeCode.DiffForm.pas',
  ClaudeCode.EditorSync in 'src\ClaudeCode.EditorSync.pas',
  ClaudeCode.ComponentProps in 'src\ClaudeCode.ComponentProps.pas',
  ClaudeCode.FormTools in 'src\ClaudeCode.FormTools.pas',
  ClaudeCode.DebugTools in 'src\ClaudeCode.DebugTools.pas',
  ClaudeCode.FileHistory in 'src\ClaudeCode.FileHistory.pas',
  ClaudeCode.CodeTools in 'src\ClaudeCode.CodeTools.pas',
  ClaudeCode.AppAutomation in 'src\ClaudeCode.AppAutomation.pas',
  ClaudeCode.ProjectMap in 'src\ClaudeCode.ProjectMap.pas',
  ClaudeCode.ProjectMapForm in 'src\ClaudeCode.ProjectMapForm.pas',
  ClaudeCode.DbInfo in 'src\ClaudeCode.DbInfo.pas',
  ClaudeCode.DbTools in 'src\ClaudeCode.DbTools.pas',
  ClaudeCode.Modernize in 'src\ClaudeCode.Modernize.pas',
  ClaudeCode.ModernizeForm in 'src\ClaudeCode.ModernizeForm.pas',
  ClaudeCode.Prompts in 'src\ClaudeCode.Prompts.pas',
  ClaudeCode.Timeline in 'src\ClaudeCode.Timeline.pas',
  ClaudeCode.TimelineForm in 'src\ClaudeCode.TimelineForm.pas',
  ClaudeCode.InlineDiff in 'src\ClaudeCode.InlineDiff.pas',
  ClaudeCode.IdeTrees in 'src\ClaudeCode.IdeTrees.pas',
  ClaudeCode.BackgroundTasks in 'src\ClaudeCode.BackgroundTasks.pas',
  ClaudeCode.DelphiLsp in 'src\ClaudeCode.DelphiLsp.pas',
  ClaudeCode.SettingsForm in 'src\ClaudeCode.SettingsForm.pas',
  ClaudeCode.ClaudeMd in 'src\ClaudeCode.ClaudeMd.pas',
  ClaudeCode.ContextMenus in 'src\ClaudeCode.ContextMenus.pas',
  ClaudeCode.IdeBackend in 'src\ClaudeCode.IdeBackend.pas',
  ClaudeCode.Launcher in 'src\ClaudeCode.Launcher.pas',
  ClaudeCode.ConPty in 'src\ClaudeCode.ConPty.pas',
  ClaudeCode.WebViewHost in 'src\ClaudeCode.WebViewHost.pas',
  ClaudeCode.TerminalFrame in 'src\ClaudeCode.TerminalFrame.pas' {ClaudeTerminalFrame: TFrame},
  ClaudeCode.TerminalPanel in 'src\ClaudeCode.TerminalPanel.pas',
  ClaudeCode.Wizard in 'src\ClaudeCode.Wizard.pas';

end.
